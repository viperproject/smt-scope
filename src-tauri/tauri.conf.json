{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "SMTScope",
  "version": "0.1.0",
  "identifier": "com.viperproject.smt-scope",
  "build": {
    "frontendDist": "../smt-scope-gui/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "cd smt-scope-gui && trunk serve --features tauri --cargo-profile=test",
    "beforeBuildCommand": "cd smt-scope-gui && trunk build --features tauri --release"
  },
  "app": {
    "windows": [
      {
        "title": "SMTScope",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
