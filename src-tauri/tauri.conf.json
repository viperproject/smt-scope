{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "SMTScope",
  "version": "0.4.1",
  "identifier": "com.viperproject.smt-scope",
  "build": {
    "frontendDist": "../smt-scope-gui/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "cd smt-scope-gui && trunk serve --features tauri --cargo-profile=test",
    "beforeBuildCommand": "cd smt-scope-gui && trunk build --features tauri --release"
  },
  "app": {
    "windows": [
      {
        "title": "SMTScope",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQzhGNUM0OUEzMTkyRkUKUldUK2tqR2F4UFhJL1MxaU92cHB1ZjRMY0h5WlZiVUJPc2ViUlk3VUV0dmtMZ2kyMW1KR3ltbEYK",
      "endpoints": [
        "https://github.com/viperproject/smt-scope/releases/latest/download/latest.json"
      ]
    }
  }
}
